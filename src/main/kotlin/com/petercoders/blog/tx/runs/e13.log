listener(AfterCommitPlain) thread=main actualTransactionActive=true name=com.petercoders.blog.txevent.OrderPlacer.place boundConnection=true connection.autoCommit=false poolActive=1
caller: returned normally
rows committed = 2 [outer, listener]   (counted afterwards on a fresh connection)
poolActive after call = 0

