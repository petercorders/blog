# experiment: e3-java (멈춘 것을 다시 돌리는 스케줄러 — virtual thread carrier pool size vs parallelism override)
# java -version: openjdk version "26.0.2.1" 2026-08-18 / OpenJDK Runtime Environment (build 26.0.2.1+1-7) / OpenJDK 64-Bit Server VM (build 26.0.2.1+1-7, mixed mode, sharing)
# machine: Apple M5 Pro, 15 cores (hw.ncpu), hw.cachelinesize=128
# commands: J26=$(/usr/libexec/java_home -v 26); $J26/bin/java java/VtWorkers.java ; $J26/bin/java -Djdk.virtualThreadScheduler.parallelism=4 java/VtWorkers.java

---default run---
cores=15 carriers=13 [ForkJoinPool-1-worker-1, ForkJoinPool-1-worker-10, ForkJoinPool-1-worker-11, ForkJoinPool-1-worker-12, ForkJoinPool-1-worker-15, ForkJoinPool-1-worker-2, ForkJoinPool-1-worker-3, ForkJoinPool-1-worker-4, ForkJoinPool-1-worker-5, ForkJoinPool-1-worker-6, ForkJoinPool-1-worker-7, ForkJoinPool-1-worker-8, ForkJoinPool-1-worker-9]
sample toString: VirtualThread[#1049]/new

---parallelism=4 run---
cores=15 carriers=4 [ForkJoinPool-1-worker-1, ForkJoinPool-1-worker-2, ForkJoinPool-1-worker-3, ForkJoinPool-1-worker-4]
