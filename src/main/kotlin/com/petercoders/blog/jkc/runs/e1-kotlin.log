=== source: Susp.kt ===
import kotlinx.coroutines.*
suspend fun step(x: Int): Int { delay(1); return x + 1 }
suspend fun work(): Int {
    val a = step(1)      // 서스펜션 포인트 1 → label 1
    val b = step(a)      // 서스펜션 포인트 2 → label 2
    return a + b
}
fun main() = runBlocking { println(work()) }

