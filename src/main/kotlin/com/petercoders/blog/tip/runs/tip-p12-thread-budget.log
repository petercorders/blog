# command: kotlinc -cp $CO ThreadBudget.kt -include-runtime -d tb.jar && for r in 1 2 3; do for c in DEF IO LP10 LP100 ALL; do java -cp tb.jar:$CO ThreadBudgetKt $c; done; done
