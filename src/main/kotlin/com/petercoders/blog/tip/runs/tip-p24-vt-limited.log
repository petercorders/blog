# command: kotlinc -cp $CO IoVsLoom.kt -include-runtime -d ivl.jar && for r in 1 2 3; do for c in VTLP10 IOLP10 VT100; do java -cp ivl.jar:$CO IoVsLoomKt $c; done; done
