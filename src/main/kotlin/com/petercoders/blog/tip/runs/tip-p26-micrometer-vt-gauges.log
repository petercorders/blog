registered: [jvm.threads.virtual.live[tag(scheduling.status=mounted)], jvm.threads.virtual.live[tag(scheduling.status=queued)], jvm.threads.virtual.parallelism[], jvm.threads.virtual.pinned[], jvm.threads.virtual.pool.size[], jvm.threads.virtual.submit.failed[]]
