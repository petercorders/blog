# command: kotlinc -cp $CO ScopeLink.kt -include-runtime -d ScopeLink.jar && java -cp ScopeLink.jar:$CO ScopeLinkKt ; kotlinc -cp kotlinx-coroutines-core-jvm-1.11.0.jar ScopeLink.kt -d l11/
$ java -cp ScopeLink.jar:$CO ScopeLinkKt
(a1) root launch(CEH[root]) { launch { throw } }
  CEH[root] called: child of root
(a2) root launch { launch(CEH[child]) { throw } }
  uncaught on DefaultDispatcher-worker-2: IllegalStateException child with its own CEH
(a3) supervisorScope { launch(CEH[sv-child]) { throw } }
  CEH[sv-child] called: direct child of supervisorScope
(a4) root async(CEH[async]) { throw }  then await()
  await() threw: root async
(b) scope.launch(SupervisorJob()) survives scope.cancel()
  after scope.cancel() + 100 ms: tied.isActive=false  detached(SupervisorJob).isActive=true

(c) $ kotlinc -cp kotlinx-coroutines-core-jvm-1.10.2.jar ScopeLink.kt -d l10/   # 경고 출력
