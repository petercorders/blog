## [A1c] 사용자가 Executor 빈을 등록했을 때
applicationTaskExecutor 빈 존재 = false
taskScheduler class=org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler poolSize=0
Executor 타입 빈 = [myOwnExecutor, taskScheduler]
TaskExecutor 타입 빈 = [taskScheduler]
TaskScheduler 타입 빈 = [taskScheduler]
AsyncConfigurer 빈 = []
@Async 가 실제로 올라탄 스레드: name=scheduling-1 virtual=false
## [A1c-force] 같은 상황 + spring.task.execution.mode=force
applicationTaskExecutor 빈 존재 = true
  class=org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor core=8 max=2147483647 queueCapacity=2147483647 keepAliveSec=60
taskScheduler class=org.springframework.scheduling.concurrent.ThreadPoolTaskScheduler poolSize=0
Executor 타입 빈 = [applicationTaskExecutor, myOwnExecutor, taskScheduler]
TaskExecutor 타입 빈 = [applicationTaskExecutor, taskScheduler]
TaskScheduler 타입 빈 = [taskScheduler]
AsyncConfigurer 빈 = [applicationTaskExecutorAsyncConfigurer]
@Async 가 실제로 올라탄 스레드: name=task-1 virtual=false
