## [S5d] @PostFilter 식 안의 @bean 조회 — DB 쪽 실행 횟수(H2 QUERY_STATISTICS)
H2 version = 2.4.240

[n=0] doc rows = 0, alice readable = 0
  @PostFilter listAll() -> returned 0 []
    executions=1  select id from doc order by id
    total DB executions = 1
  where 절 listReadable(alice) -> returned 0 []
    executions=1  select d.id from doc d join doc_acl a on a.doc_id = d.id where a.username = ? order by d.id
    total DB executions = 1

[n=3] doc rows = 3, alice readable = 2
  @PostFilter listAll() -> returned 2 [d0, d2]
    executions=3  select count(*) from doc_acl where doc_id = ? and username = ?
    executions=1  select id from doc order by id
    total DB executions = 4
  where 절 listReadable(alice) -> returned 2 [d0, d2]
    executions=1  select d.id from doc d join doc_acl a on a.doc_id = d.id where a.username = ? order by d.id
    total DB executions = 1

[n=10] doc rows = 10, alice readable = 5
  @PostFilter listAll() -> returned 5 [d0, d2, d4, d6, d8]
    executions=10  select count(*) from doc_acl where doc_id = ? and username = ?
    executions=1  select id from doc order by id
    total DB executions = 11
  where 절 listReadable(alice) -> returned 5 [d0, d2, d4, d6, d8]
    executions=1  select d.id from doc d join doc_acl a on a.doc_id = d.id where a.username = ? order by d.id
    total DB executions = 1
# exit=0
