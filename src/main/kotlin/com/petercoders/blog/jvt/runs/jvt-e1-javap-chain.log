# jvt-e1-javap-chain: 스택이 객체가 되는 순간 - javap 로 추적한 VirtualThread parkNanos -> yieldContinuation -> Continuation.yield -> yield0 -> doYield 체인, 그리고 JDK19 vs JDK26 StackChunk 필드 변화(argsize -> bottom)
# java -version: openjdk version "26.0.2.1" 2026-08-18
OpenJDK Runtime Environment (build 26.0.2.1+1-7)
OpenJDK 64-Bit Server VM (build 26.0.2.1+1-7, mixed mode, sharing)
# 기기: Apple M5 Pro / cores=15 / hw.cachelinesize=128
# 실행 명령:
#   J26=$(/usr/libexec/java_home -v 26); J19=$(/usr/libexec/java_home -v 19)
#   $J26/bin/javap -c -p java.lang.VirtualThread | grep -nE 'void parkNanos\(long\)|yieldContinuation|jdk/internal/vm/Continuation\.yield|parkOnCarrierThread' | head -20
#   $J26/bin/javap -c -p jdk.internal.vm.Continuation | grep -nE 'static boolean yield\(|private boolean yield0|doYield|enterSpecial' | head
#   $J26/bin/javap -p jdk.internal.vm.StackChunk
#   $J19/bin/javap -p jdk.internal.vm.StackChunk

