# e6-aotmap: AOT 캐시 맵(blog.aot.map) 안에 실제로 뭐가 들어있는지 훑는다 (영역별 크기, 항목 유형별 개수)
# java -version: openjdk version "26.0.2.1" 2026-08-18 / OpenJDK Runtime Environment (build 26.0.2.1+1-7) / OpenJDK 64-Bit Server VM (build 26.0.2.1+1-7, mixed mode, sharing)
#   (단, AOT 캐시 실측 자체는 setup.sh 가 지정하는 JDK 25 로 돈다: OpenJDK 64-Bit Server VM Microsoft-14951866 (build 25.0.4.1+1-LTS) for bsd-aarch64, /usr/bin/java(26)에는 -XX:AOTMode 자체가 없어 그대로는 못 돌린다)
# 기기: Apple M5 Pro, 15 cores(15 logical/15 physical), hw.cachelinesize=128
# 실행한 명령:
#   AOT=~/Desktop/development/blog/src/main/kotlin/com/petercoders/blog/aot
#   $AOT/setup.sh
#   W=$AOT/runs/work; M=$W/blog.aot.map
#   wc -l $M; ls -l $M; head -30 $M
#   grep -n '============ region' $M                     # 실제 상세 region 헤더 포맷 (원 명령의 '[... region ...]' 브래킷 패턴은 안 맞아 이걸로 교체)
#   grep -A9 '============ region' $M | grep -E '============ region|used:'
#   grep -n '^\[' $M                                       # 원 명령의 브래킷 패턴이 실제로 걸리는 자리(섹션 시작 마커) 확인
#   grep -oE '@@ [A-Za-z]+' $M | sort | uniq -c | sort -rn  # 항목 유형별(@@ 태그) 개수 — 이게 실제 맵의 엔트리 태그 포맷
#   grep -c '@@ Class ' / '@@ Method ' / '@@ ConstantPool ' / '@@ ConstantPoolCache' / '@@ Object' / '@@ MethodTrainingData' / '@@ CompileTrainingData' / '@@ KlassTrainingData' $M
#   grep -ci 'trainingdata' $M; grep -c 'java.lang.Class' $M; grep -c 'java.lang.String' $M   # 원 명령 그대로(리터럴 패턴) 돌린 대조값
#   grep -iE 'Number of classes|classes|heap|bytes|Shared file region' $W/create.log

