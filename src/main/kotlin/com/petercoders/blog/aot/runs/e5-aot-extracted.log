# 실험: e5-aot-extracted — fat jar 를 펼친(extracted) 뒤 AOT 캐시를 적용하면 fat jar 의 함정(nested jar 라 클래스가 캐시에서 안 뜨는 문제)이 풀리는가
# java -version (J25, ~/Library/Java/JavaVirtualMachines/ms-25.0.4.1/Contents/Home/bin/java): openjdk version "25.0.4.1" 2026-08-18 LTS / OpenJDK Runtime Environment Microsoft-14951866 (build 25.0.4.1+1-LTS) / OpenJDK 64-Bit Server VM Microsoft-14951866 (build 25.0.4.1+1-LTS, mixed mode, sharing)
# 기기: Apple M5 Pro / 코어 15개 / hw.cachelinesize 128 bytes
# 실행한 명령: AOT=~/Desktop/development/blog/src/main/kotlin/com/petercoders/blog/aot ; J25=~/Library/Java/JavaVirtualMachines/ms-25.0.4.1/Contents/Home/bin/java ; $AOT/setup.sh ; W=$AOT/runs/work; APP=$W/application/blog-0.0.1-SNAPSHOT.jar ; ls -l $W/blog.aot $W/blog.aotconf ; unzip -p $APP META-INF/MANIFEST.MF | grep -A2 'Class-Path' | head -3 ; uptime ; $AOT/bench.sh extracted-baseline 5 $J25 -jar $APP ; $AOT/bench.sh extracted-aot 5 $J25 -XX:AOTCache=$W/blog.aot -jar $APP ; $J25 -XX:AOTCache=$W/blog.aot -Xlog:class+load:file=$W/classload-aot.log -jar $APP > /dev/null 2>&1 ; echo total=$(wc -l < $W/classload-aot.log); echo shared=$(grep -c 'source: shared objects file' $W/classload-aot.log); echo jarsrc=$(grep -c 'source: jar:\|source: file:' $W/classload-aot.log) ; $J25 -XX:AOTCache=$W/blog.aot -XX:+UnlockDiagnosticVMOptions -XX:+PrintFlagsFinal -jar $APP 2>/dev/null | grep -E ' (AOTClassLinking|AOTReplayTraining|AOTRecordTraining|AOTInvokeDynamicLinking|AOTMode|AOTAdapterCaching|AOTStubCaching) '

