# experiment: e4-aot-fatjar (절: 캐시 뜨기, 그리고 fat jar 의 함정)
# java -version (JDK25, ms-25.0.4.1): openjdk version "25.0.4.1" 2026-08-18 LTS / OpenJDK Runtime Environment Microsoft-14951866 (build 25.0.4.1+1-LTS) / OpenJDK 64-Bit Server VM Microsoft-14951866 (build 25.0.4.1+1-LTS, mixed mode, sharing)
# device: Apple M5 Pro, 15 cores (hw.physicalcpu=15, hw.logicalcpu=15), hw.cachelinesize=128
# commands: AOT=~/Desktop/development/blog/src/main/kotlin/com/petercoders/blog/aot ; J25=~/Library/Java/JavaVirtualMachines/ms-25.0.4.1/Contents/Home/bin/java ; JAR=~/Desktop/development/blog/build/libs/blog-0.0.1-SNAPSHOT.jar ; WF=$AOT/runs/work-fat; mkdir -p $WF; cd $WF ; $J25 -XX:AOTMode=record -XX:AOTConfiguration=fat.aotconf -jar $JAR > record.log 2>&1 ; $J25 -XX:AOTMode=create -XX:AOTConfiguration=fat.aotconf -XX:AOTCache=fat.aot -Xlog:aot=info:file=create.log:none -jar $JAR ; ls -l fat.aotconf fat.aot ; grep -iE 'skip|exclud|unregistered|not.*archiv|warning' create.log | head -10 ; uptime ; $AOT/bench.sh fatjar-aot 5 $J25 -XX:AOTCache=$WF/fat.aot -jar $JAR ; $J25 -XX:AOTCache=$WF/fat.aot -Xlog:class+load:file=$WF/classload.log -jar $JAR > /dev/null 2>&1 ; echo total=$(wc -l < $WF/classload.log); echo shared=$(grep -c 'source: shared objects file' $WF/classload.log); echo nested=$(grep -c 'source: nested:' $WF/classload.log)

